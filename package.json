{
  "name": "yc-startup-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.3",
    "yarn": "please use npm",
    "pnpm": "please use npm"
  },
  "description": "A map visualization of the YC Startup Directory",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview",
